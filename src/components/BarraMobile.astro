---
import { wa, mensagens } from '../data/site';
---
<div class="barra" data-barra aria-hidden="true" inert>
  <a class="btn btn-p" href={wa(mensagens.geral)} target="_blank" rel="noopener" data-evento="clique_whatsapp" data-local="barra-mobile">Consultar datas no WhatsApp</a>
</div>

<script>
  // Mostra a barra fixa no celular depois que o hero sai da tela e esconde perto do rodapé.
  const barra = document.querySelector<HTMLElement>('[data-barra]');
  const hero = document.getElementById('topo');
  const rodape = document.querySelector('footer.rod');
  if (barra && hero && 'IntersectionObserver' in window) {
    let heroVisivel = true;
    let rodapeVisivel = false;
    const atualizar = () => {
      const mostrar = !heroVisivel && !rodapeVisivel;
      barra.classList.toggle('on', mostrar);
      barra.toggleAttribute('inert', !mostrar);
      barra.setAttribute('aria-hidden', String(!mostrar));
    };
    new IntersectionObserver(([e]) => { heroVisivel = e.isIntersecting; atualizar(); }).observe(hero);
    if (rodape) new IntersectionObserver(([e]) => { rodapeVisivel = e.isIntersecting; atualizar(); }).observe(rodape);
  }
</script>

<style>
  .barra { display: none; }
  @media (max-width: 700px) {
    .barra {
      display: flex; position: fixed; left: 0; right: 0; bottom: 0; z-index: 30;
      padding: 12px 16px calc(12px + env(safe-area-inset-bottom));
      background: var(--cal); border-top: 1px solid var(--linha);
      transform: translateY(110%); transition: transform .25s ease;
    }
    .barra.on { transform: none; }
    .barra .btn { flex: 1; }
  }
</style>
