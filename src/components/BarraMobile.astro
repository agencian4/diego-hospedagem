---
import { wa, mensagens } from '../data/site';
---
<!-- Celular: barra fixa no rodapé da tela -->
<div class="barra" data-flutuante aria-hidden="true" inert>
  <a class="btn btn-p" href={wa(mensagens.geral)} target="_blank" rel="noopener" data-evento="clique_whatsapp" data-local="barra-mobile">Consultar datas no WhatsApp</a>
</div>

<!-- Computador: botão flutuante no canto inferior direito -->
<a class="flutuante" data-flutuante aria-hidden="true" inert href={wa(mensagens.geral)} target="_blank" rel="noopener" data-evento="clique_whatsapp" data-local="botao-flutuante" aria-label="Falar no WhatsApp">
  <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21h.01c5.46 0 9.91-4.45 9.91-9.91a9.85 9.85 0 0 0-2.9-7.01A9.82 9.82 0 0 0 12.04 2zm0 18.15h-.01a8.23 8.23 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.25-8.23a8.2 8.2 0 0 1 5.83 2.42 8.18 8.18 0 0 1 2.41 5.82c0 4.54-3.7 8.23-8.24 8.23zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.17.24-.64.8-.78.97-.15.17-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.13-.15.17-.25.25-.42.08-.16.04-.31-.02-.43-.06-.13-.56-1.35-.76-1.84-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.22.25-.86.85-.86 2.07s.88 2.4 1 2.56c.13.17 1.74 2.65 4.21 3.72.59.25 1.05.41 1.4.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.06-.1-.23-.16-.48-.29z"/></svg>
  <span>WhatsApp</span>
</a>

<script>
  // Mostra a barra (celular) e o botão flutuante (computador) depois que a primeira dobra sai da tela,
  // e esconde os dois perto do rodapé, onde já existe a chamada final para o WhatsApp.
  const itens = document.querySelectorAll<HTMLElement>('[data-flutuante]');
  const hero = document.getElementById('topo');
  const rodape = document.querySelector('footer.rod');
  if (itens.length && hero && 'IntersectionObserver' in window) {
    let heroVisivel = true;
    let rodapeVisivel = false;
    const atualizar = () => {
      const mostrar = !heroVisivel && !rodapeVisivel;
      itens.forEach((el) => {
        el.classList.toggle('on', mostrar);
        el.toggleAttribute('inert', !mostrar);
        el.setAttribute('aria-hidden', String(!mostrar));
      });
    };
    new IntersectionObserver(([e]) => { heroVisivel = e.isIntersecting; atualizar(); }).observe(hero);
    if (rodape) new IntersectionObserver(([e]) => { rodapeVisivel = e.isIntersecting; atualizar(); }).observe(rodape);
  }
</script>

<style>
  .barra { display: none; }
  .flutuante {
    position: fixed; right: 28px; bottom: 28px; z-index: 30;
    display: inline-flex; align-items: center; gap: 10px;
    min-height: 56px; padding: 0 22px 0 18px;
    background: var(--anil); color: var(--cal);
    font: 600 16px/1 var(--sans); text-decoration: none; border-radius: 2px;
    box-shadow: 0 10px 28px rgba(29, 47, 111, 0.28);
    opacity: 0; transform: translateY(16px); pointer-events: none;
    transition: opacity .25s ease, transform .25s ease, background-color .2s ease;
  }
  .flutuante.on { opacity: 1; transform: none; pointer-events: auto; }
  .flutuante:hover { background: var(--telha); color: var(--cal); }
  .flutuante:focus-visible { outline: 3px solid var(--telha); outline-offset: 3px; }

  @media (max-width: 700px) {
    .flutuante { display: none; }
    .barra {
      display: flex; position: fixed; left: 0; right: 0; bottom: 0; z-index: 30;
      padding: 12px 16px calc(12px + env(safe-area-inset-bottom));
      background: var(--cal); border-top: 1px solid var(--linha);
      transform: translateY(110%); transition: transform .25s ease;
    }
    .barra.on { transform: none; }
    .barra .btn { flex: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .flutuante, .barra { transition: none; }
  }
</style>
