---
import Foto from './Foto.astro';
import { wa, mensagens } from '../data/site';
---
<section id="topo" class="hero wrap" aria-labelledby="hero-titulo">
  <div class="texto">
    <h1 id="hero-titulo"><span class="l1">Atravesse a rua.</span><br /><span class="l2">O mar é ali.</span></h1>
    <p class="lead sub">Dois flats na Avenida Litorânea, em São Luís, com piscina no condomínio, garagem e o vento da orla entrando pela varanda. E, quando você quiser seguir viagem, um transfer particular até os Lençóis Maranhenses.</p>
    <div class="acoes">
      <a class="btn btn-p" href={wa(mensagens.geral)} target="_blank" rel="noopener" data-evento="clique_whatsapp" data-local="hero">
        Consultar datas no WhatsApp
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
      </a>
      <a class="btn btn-g" href="#flats">Conhecer os dois flats</a>
    </div>
  </div>
  <div class="fotos">
    <div class="foto f-alta">
      <Foto nome="hero-orla-coqueiros" alt="Calçadão, coqueiros e o mar da Avenida Litorânea vistos do prédio" sizes="(max-width: 900px) 100vw, 26vw" prioridade posicao="50% 60%" />
    </div>
    <div class="col">
      <div class="foto f-baixa">
        <Foto nome="varanda-entardecer" alt="Varanda do flat, com o mar da Litorânea ao fundo" sizes="(max-width: 900px) 50vw, 17vw" posicao="78% 50%" />
      </div>
      <p class="legenda">Avenida Litorânea, Calhau.<br />A praia fica do outro lado da rua.</p>
    </div>
  </div>
</section>

<style>
  .hero { display: flex; flex-wrap: wrap; gap: clamp(32px, 4vw, 64px); align-items: flex-end; padding-top: clamp(40px, 6vw, 88px); padding-bottom: 56px; }
  .texto { flex: 999 1 560px; min-width: 0; display: flex; flex-direction: column; gap: 32px; }
  h1 { font: 400 clamp(54px, 7.4vw, 116px)/0.94 var(--serif); letter-spacing: -0.02em; }
  @media (min-width: 901px) { h1 .l1 { white-space: nowrap; } }
  h1 .l2 { color: var(--telha); }
  .sub { max-width: 560px; font-size: 20px; }
  .acoes { display: flex; flex-wrap: wrap; gap: 14px; }
  .fotos { flex: 1 1 420px; min-width: 0; display: flex; gap: 16px; align-items: flex-end; }
  .f-alta { flex: 1 1 60%; height: 560px; }
  .col { flex: 1 1 40%; display: flex; flex-direction: column; gap: 16px; }
  .f-baixa { height: 250px; }
  .legenda { font: 500 13px/1.5 var(--sans); color: var(--suave); }
  @media (max-width: 900px) {
    .hero { padding-top: 28px; }
    .fotos { order: -1; margin-inline: calc(var(--margem) * -1); gap: 8px; }
    .f-alta { height: 340px; }
    .f-baixa { height: 340px; }
    .col { flex: 0 0 38%; }
    .legenda { display: none; }
    .sub { font-size: 17px; }
    .acoes .btn { flex: 1 1 100%; }
  }
</style>
