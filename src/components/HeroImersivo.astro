---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { wa, mensagens } from '../data/site';

// Fotos do fundo da primeira dobra. Para trocar, substitua o arquivo em src/assets/photos
// (ou mude o nome aqui) e ajuste o ponto de foco em `foco`.
const HERO = {
  desktop: { nome: 'hero-desktop', foco: '62% 50%' }, // horizontal, mínimo 2400 px de largura
  celular: { nome: 'hero-celular', foco: '50% 46%' }, // vertical; no celular a foto fica acima do texto
  alt: 'O mar da Avenida Litorânea, em São Luís, visto do prédio dos flats',
};

const fotos = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/*.jpg', { eager: true });
const arq = (n: string) => {
  const f = fotos[`../assets/photos/${n}.jpg`];
  if (!f) throw new Error(`Foto não encontrada: ${n}`);
  return f.default;
};

async function srcset(src: ImageMetadata, larguras: number[], format: 'avif' | 'webp' | 'jpg') {
  const imgs = await Promise.all(larguras.map((w) => getImage({ src, width: Math.min(w, src.width), format, quality: 72 })));
  return imgs.map((i, k) => `${i.src} ${Math.min(larguras[k], src.width)}w`).join(', ');
}

const d = arq(HERO.desktop.nome);
const c = arq(HERO.celular.nome);
const LD = [1200, 1600, 2000, 2400];
const LC = [480, 750, 1000, 1300];
const fallback = await getImage({ src: d, width: Math.min(1600, d.width), format: 'jpg', quality: 72 });
const fontes = {
  cAvif: await srcset(c, LC, 'avif'), cWebp: await srcset(c, LC, 'webp'),
  dAvif: await srcset(d, LD, 'avif'), dWebp: await srcset(d, LD, 'webp'),
};
---
<section id="topo" class="hero" aria-labelledby="hero-titulo" style={`--foco-d:${HERO.desktop.foco};--foco-c:${HERO.celular.foco}`}>
  <picture class="fundo">
    <source media="(max-width: 900px)" type="image/avif" srcset={fontes.cAvif} sizes="100vw" />
    <source media="(max-width: 900px)" type="image/webp" srcset={fontes.cWebp} sizes="100vw" />
    <source type="image/avif" srcset={fontes.dAvif} sizes="100vw" />
    <source type="image/webp" srcset={fontes.dWebp} sizes="100vw" />
    <img src={fallback.src} alt={HERO.alt} width={d.width} height={d.height} fetchpriority="high" loading="eager" decoding="sync" />
  </picture>
  <div class="wrap conteudo">
    <h1 id="hero-titulo"><span class="l1">Atravesse a rua.</span><br /><span class="l2">O mar é ali.</span></h1>
    <p class="sub">Dois flats na Avenida Litorânea, em São Luís, com piscina, garagem e o vento da orla entrando pela varanda. E transfer particular até os Lençóis Maranhenses.</p>
    <div class="acoes">
      <a class="btn btn-l" href={wa(mensagens.geral)} target="_blank" rel="noopener" data-evento="clique_whatsapp" data-local="hero">
        Consultar datas no WhatsApp
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
      </a>
      <a class="btn btn-claro" href="#flats">Conhecer os dois flats</a>
    </div>
  </div>
  <ul class="faixa wrap">
    <li><strong>5,0</strong> Flat 203, Preferido dos hóspedes no Airbnb</li>
    <li><strong>1 rua</strong> entre o prédio e a areia da praia</li>
    <li><strong>R$ 800</strong> transfer aos Lençóis, a partir de, por veículo</li>
  </ul>
</section>

<style>
  .hero { position: relative; min-height: clamp(640px, calc(100svh - 81px), 940px); display: flex; flex-direction: column; justify-content: flex-end; color: var(--cal); overflow: hidden; background: var(--anil); }
  .fundo { position: absolute; inset: 0; }
  .fundo img { width: 100%; height: 100%; object-fit: cover; object-position: var(--foco-d); display: block; }
  .fundo::after { content: ''; position: absolute; inset: 0;
    background: linear-gradient(90deg, rgba(17, 27, 66, .9) 0%, rgba(17, 27, 66, .72) 34%, rgba(17, 27, 66, 0) 66%),
                linear-gradient(0deg, rgba(17, 27, 66, .85) 0%, rgba(17, 27, 66, 0) 34%); }
  .conteudo { position: relative; width: 100%; display: flex; flex-direction: column; gap: 28px; padding-bottom: 48px; }
  h1 { font: 400 clamp(56px, 8.2vw, 132px)/0.92 var(--serif); letter-spacing: -0.02em; max-width: 11ch; }
  h1 .l2 { color: var(--telha-claro); }
  .sub { max-width: 520px; font: 400 19px/1.55 var(--sans); color: #e6e2d8; }
  .acoes { display: flex; flex-wrap: wrap; gap: 14px; }
  .btn-claro { color: var(--cal); border-color: rgba(243, 239, 230, .7); background: transparent; }
  .btn-claro:hover { color: var(--cal); border-color: var(--cal); background: rgba(243, 239, 230, .1); }
  .faixa { position: relative; width: 100%; list-style: none; margin: 0 auto; display: flex; flex-wrap: wrap; background: linear-gradient(rgba(243, 239, 230, .35), rgba(243, 239, 230, .35)) center top / calc(100% - 2 * var(--margem)) 1px no-repeat; padding-top: 18px; padding-bottom: 26px; gap: 12px 0; }
  .faixa li { flex: 1 1 240px; display: flex; align-items: baseline; gap: 12px; font: 500 14px/1.4 var(--sans); color: #e6e2d8; padding-right: 24px; }
  .faixa strong { font: 400 34px/1 var(--serif); color: var(--cal); white-space: nowrap; }
  @media (max-width: 900px) {
    .hero { min-height: 0; justify-content: flex-start; }
    .fundo { position: relative; inset: auto; height: 42svh; min-height: 280px; max-height: 420px; }
    .fundo img { object-position: var(--foco-c); }
    .fundo::after { background: linear-gradient(0deg, rgba(29, 47, 111, 1) 0%, rgba(29, 47, 111, 0) 38%); }
    .conteudo { gap: 20px; padding-top: 4px; padding-bottom: 28px; margin-top: -44px; }
    .sub { font-size: 16px; }
    .acoes .btn { flex: 1 1 100%; }
    .faixa li:nth-child(n+2) { display: none; }
  }
</style>
