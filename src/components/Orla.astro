---
import Foto from './Foto.astro';
import { orla } from '../data/site';
---
<div class="azulejo" aria-hidden="true">
  <svg width="100%" height="40" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <pattern id="az" width="40" height="40" patternUnits="userSpaceOnUse">
        <rect width="40" height="40" fill="#f3efe6" />
        <path d="M0 0a20 20 0 0 1 20 20A20 20 0 0 1 0 40M40 0a20 20 0 0 0-20 20 20 20 0 0 0 20 20" fill="none" stroke="#1d2f6f" stroke-width="1.5" />
        <path d="M20 12l8 8-8 8-8-8z" fill="#1d2f6f" />
      </pattern>
    </defs>
    <rect width="100%" height="40" fill="url(#az)" />
  </svg>
</div>

<section id="orla" class="wrap orla" aria-labelledby="orla-titulo">
  <div class="topo">
    <h2 id="orla-titulo" class="h2">A Litorânea na porta. São Luís inteira por perto.</h2>
    <p class="lead">O Calhau é o trecho mais vivo da orla: calçadão para caminhar, bares, restaurantes e food trucks no fim de tarde. Dá para viver a viagem a pé e chamar um carro só para o centro histórico.</p>
  </div>

  <ol class="linha">
    {orla.map((p) => (
      <li>
        <span class:list={['ponto', { destaque: p.destaque, vazado: p.vazado }]} aria-hidden="true"></span>
        <strong class="serif">{p.nome}</strong>
        <span class="txt">{p.texto}</span>
      </li>
    ))}
  </ol>

  <div class="galeria">
    <div class="foto g1"><Foto nome="orla-litoranea" alt="O mar e os coqueiros da Litorânea vistos do flat" sizes="(max-width: 900px) 100vw, 50vw" posicao="50% 62%" /></div>
    <div class="foto g2"><Foto nome="orla-fim-de-tarde" alt="Coqueiro e o mar no fim de tarde, vistos do flat" sizes="(max-width: 900px) 50vw, 25vw" posicao="50% 30%" /></div>
    <div class="foto g3"><Foto nome="orla-nublado" alt="O mar da Litorânea além dos telhados, em dia nublado" sizes="(max-width: 900px) 50vw, 25vw" posicao="50% 70%" /></div>
  </div>
</section>

<style>
  .azulejo { margin-top: 96px; height: 40px; }
  .azulejo svg { display: block; }
  .orla { padding-top: 96px; padding-bottom: var(--secao); }
  .topo { display: flex; flex-wrap: wrap; gap: 32px 48px; align-items: flex-end; justify-content: space-between; }
  .topo .h2 { flex: 1 1 620px; max-width: 820px; }
  .topo .lead { flex: 1 1 360px; max-width: 440px; }
  .linha { margin-top: 72px; display: flex; flex-wrap: wrap; border-top: 1.5px solid var(--linha-forte); }
  .linha li { flex: 1 1 200px; padding: 20px 20px 0 0; display: flex; flex-direction: column; gap: 10px; }
  .ponto { width: 14px; height: 14px; border-radius: 50%; background: var(--anil); margin-top: -28px; }
  .ponto.destaque { background: var(--telha); }
  .ponto.vazado { background: var(--cal); border: 2px solid var(--anil); }
  .linha strong { font-size: 26px; line-height: 1.1; }
  .txt { font: 400 15px/1.5 var(--sans); color: var(--texto); max-width: 240px; }
  .galeria { margin-top: 64px; display: flex; flex-wrap: wrap; gap: 16px; }
  .g1 { flex: 2 1 520px; height: 420px; }
  .g2, .g3 { flex: 1 1 260px; height: 420px; }
  @media (max-width: 700px) {
    .azulejo { margin-top: 64px; }
    .orla { padding-top: 64px; }
    .linha { margin-top: 48px; border-top: 0; border-left: 1.5px solid var(--linha-forte); flex-direction: column; gap: 22px; padding-left: 22px; }
    .linha li { flex: none; padding: 0; position: relative; gap: 4px; }
    .ponto { position: absolute; left: -30px; top: 8px; margin: 0; }
    .linha strong { font-size: 24px; }
    .galeria { gap: 8px; margin-inline: calc(var(--margem) * -1); }
    .g1 { flex: 1 1 100%; height: 300px; }
    .g2, .g3 { flex: 1 1 40%; height: 220px; }
  }
</style>
